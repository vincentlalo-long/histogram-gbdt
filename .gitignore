# Byte-compiled / optimized files
__pycache__/
*.py[cod]
*$py.class

# C/C++ compiled binaries, extensions and libraries
*.so
*.pyd
*.dll
*.dylib
*.o
*.a

# Distribution / packaging
build/
dist/
*.egg-info/
*.egg

# Virtual environments
.venv/
venv/
env/
ENV/

# Testing & caches
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Benchmark artifacts & plots
bench/results/*
!bench/results/real_comparison.json
!bench/results/real_comparison.csv
!bench/results/real_runs.csv
!bench/results/real_summary.md
!bench/results/memory_real.csv
!bench/results/memory_runs.csv
!bench/results/memory_summary.md
data/

# Documentation: keep the compiled PDF and its LaTeX source
docs/*
!docs/*.pdf
!docs/*.tex
!docs/benchmark.md
!docs/figures/

# LaTeX auxiliary files
*.aux
*.log
*.out
*.toc
*.fls
*.fdb_latexmk
*.synctex.gz

# IDE / Editor & OS files
.vscode/
.idea/
.DS_Store
